# Build + machine state — never commit
*-state.env
.build/
.work/
*.log
_b_*.log

# Runtime deploy artifacts (regenerated by the toolkit)
.bedrock_agentcore/
.bedrock_agentcore.yaml
lib/runtime/ssm-pol.json

# Python venvs / caches
.venv/
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Rendered doc byproducts
docs/*.pdf
*.jpg

# Node deps for docs/generators
node_modules/

# CDK synth/build outputs
cdk/cdk.out/
cdk/.build/
__pycache__/
*.pyc

# Local secrets - never commit
.hud-token.env
*.secret.env

# CDK synth output under any suffix. `cdk/cdk.out/` alone missed the per-run
# directories the gate harness creates (cdk.out-5668, cdk.out-packcheck, ...),
# and `cdk/outputs-*.json` carries the live account id in stack outputs.
cdk.out/
cdk/cdk.out-*/
cdk.out-*/
cdk/outputs-*.json
